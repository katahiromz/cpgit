#!/bin/bash

set -e

# Argumente überprüfen
if [ "$#" -ne 2 ]; then
    echo "Verwendung: $0 <Quellverzeichnis> <Zielverzeichnis>" >&2
    exit 1
fi

SRC="$1"
DEST="$2"

# Überprüfen, ob das Quellverzeichnis existiert
if [ ! -d "$SRC" ]; then
    echo "Fehler: Quelle '$SRC' existiert nicht oder ist kein Verzeichnis." >&2
    exit 1
fi

# Überprüfen, ob die Quelle ein Git-Repository ist
if [ ! -d "$SRC/.git" ]; then
    echo "Fehler: Quelle '$SRC' enthält keinen .git-Ordner." >&2
    exit 1
fi

# Überprüfen, ob das Zielverzeichnis bereits existiert
if [ -e "$DEST" ]; then
    echo "Fehler: Ziel '$DEST' existiert bereits." >&2
    exit 1
fi

# Zielverzeichnis in absoluten Pfad umwandeln
DEST_ABS="$(mkdir -p "$DEST" && cd "$DEST" && pwd)"

# 1. Nur nachverfolgte Dateien kopieren (einschließlich Submodulen)
(
    cd "$SRC"
    git checkout-index -a -f --prefix="$DEST_ABS/"
    git submodule --quiet foreach --recursive \
        'git checkout-index -a -f --prefix="$DEST_ABS/$displaypath/"'
)

# 2. Das .git-Verzeichnis kopieren
cp -r "$SRC/.git" "$DEST/.git"

# Submodule prüfen
if [ -d "$SRC/.git/modules" ]; then
    echo "Submodule erkannt und kopiert."
fi

echo "Erfolgreich: '$SRC' wurde nach '$DEST' kopiert (Submodule enthalten, ignorierte Dateien ausgeschlossen)."
