#!/bin/bash

set -e

VERSION="1.1"

# 帮助信息
show_help() {
    cat << EOF
用法: cpgit [选项] <源目录> <目标目录>

复制 Git 仓库并排除被忽略的文件，同时保留 .git 历史记录和子模块。

选项:
  -h, --help     显示此帮助信息并退出
  -v, --version  显示版本信息并退出

示例:
  cpgit my-repo my-repo-copy
EOF
}

# 解析选项
case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
    -v|--version)
        echo "cpgit 版本 $VERSION"
        exit 0
        ;;
esac

# 检查参数
if [ "$#" -ne 2 ]; then
    echo "错误: 参数数量无效。" >&2
    show_help >&2
    exit 1
fi

SRC="$1"
DEST="$2"

# 检查源目录是否存在
if [ ! -d "$SRC" ]; then
    echo "错误: 源目录 '$SRC' 不存在或不是一个目录。" >&2
    exit 1
fi

# 检查源目录是否为 Git 仓库
if [ ! -d "$SRC/.git" ]; then
    echo "错误: 源目录 '$SRC' 中未找到 .git 文件夹。" >&2
    exit 1
fi

# 检查目标目录是否已存在
if [ -e "$DEST" ]; then
    echo "错误: 目标目录 '$DEST' 已经存在。" >&2
    exit 1
fi

# 将目标路径转换为绝对路径
DEST_ABS="$(mkdir -p "$DEST" && cd "$DEST" && pwd)"

# 1. 仅导出受版本控制的文件（包括子模块）
(
    cd "$SRC"
    git checkout-index -a -f --prefix="$DEST_ABS/"
    git submodule --quiet foreach --recursive \
        'git checkout-index -a -f --prefix="$DEST_ABS/$displaypath/"'
)

# 2. 复制 .git 目录
cp -r "$SRC/.git" "$DEST/.git"

# 检查子模块
if [ -d "$SRC/.git/modules" ]; then
    echo "已检测到并复制子模块。"
fi

echo "成功: 已将 '$SRC' 复制到 '$DEST'（包含子模块，已排除忽略文件）。"
