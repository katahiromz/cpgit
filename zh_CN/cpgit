#!/bin/bash

set -e

# 检查参数
if [ "$#" -ne 2 ]; then
    echo "用法: $0 <源目录> <目标目录>" >&2
    exit 1
fi

SRC="$1"
DEST="$2"

# 检查源目录是否存在
if [ ! -d "$SRC" ]; then
    echo "错误: 源目录 '$SRC' 不存在或不是一个目录。" >&2
    exit 1
fi

# 检查源目录是否为 Git 仓库
if [ ! -d "$SRC/.git" ]; then
    echo "错误: 源目录 '$SRC' 中未找到 .git 文件夹。" >&2
    exit 1
fi

# 检查目标目录是否已存在
if [ -e "$DEST" ]; then
    echo "错误: 目标目录 '$DEST' 已经存在。" >&2
    exit 1
fi

# 创建目标目录
mkdir -p "$DEST"

# 1. 复制文件并遵循 .gitignore 规则（包括子模块中的规则）
rsync -a --exclude='.git' --filter=':- .gitignore' "$SRC/" "$DEST/"

# 2. 复制 .git 目录（包含子模块的相关信息）
cp -r "$SRC/.git" "$DEST/.git"

# 检查子模块
if [ -d "$SRC/.git/modules" ]; then
    echo "已检测到并复制子模块。"
fi

echo "成功: 已将 '$SRC' 复制到 '$DEST'（包含子模块，已排除忽略文件）。"
