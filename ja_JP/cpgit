#!/bin/bash

set -e

VERSION="1.1"

# ヘルプメッセージ
show_help() {
    cat << EOF
使用方法: cpgit [オプション] <コピー元フォルダ> <コピー先フォルダ>

.gitignoreに指定されたファイルを除外しつつ、.gitの履歴やサブモジュールを保持してGitリポジトリをコピーします。

オプション:
  -h, --help     ヘルプメッセージを表示して終了
  -v, --version  バージョン情報を表示して終了

使用例:
  cpgit my-repo my-repo-copy
EOF
}

# オプション解析
case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
    -v|--version)
        echo "cpgit バージョン $VERSION"
        exit 0
        ;;
esac

# 引数チェック
if [ "$#" -ne 2 ]; then
    echo "エラー: 引数の数が正しくありません。" >&2
    show_help >&2
    exit 1
fi

SRC="$1"
DEST="$2"

# コピー元が存在するか
if [ ! -d "$SRC" ]; then
    echo "エラー: コピー元 '$SRC' が存在しないか、ディレクトリではありません。" >&2
    exit 1
fi

# コピー元がGitリポジトリか
if [ ! -d "$SRC/.git" ]; then
    echo "エラー: コピー元 '$SRC' に .git フォルダが見つかりません。" >&2
    exit 1
fi

# コピー先が既に存在するか確認
if [ -e "$DEST" ]; then
    echo "エラー: コピー先 '$DEST' は既に存在します。" >&2
    exit 1
fi

# コピー先を絶対パスに変換
DEST_ABS="$(mkdir -p "$DEST" && cd "$DEST" && pwd)"

# 1. Gitの管理対象ファイルのみを展開（サブモジュールも再帰的に展開）
(
    cd "$SRC"
    git checkout-index -a -f --prefix="$DEST_ABS/"
    git submodule --quiet foreach --recursive \
        'git checkout-index -a -f --prefix="$DEST_ABS/$displaypath/"'
)

# 2. .git フォルダをそのまま複製
cp -r "$SRC/.git" "$DEST/.git"

# サブモジュールの存在チェック
if [ -d "$SRC/.git/modules" ]; then
    echo "サブモジュールを検出・コピーしました。"
fi

echo "完了: '$SRC' を '$DEST' にコピーしました（サブモジュール対応、Git無視ファイル除外済み）。"
