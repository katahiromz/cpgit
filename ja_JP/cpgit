#!/bin/bash

set -e

# 引数チェック
if [ "$#" -ne 2 ]; then
    echo "使用方法: $0 <コピー元フォルダ> <コピー先フォルダ>" >&2
    exit 1
fi

SRC="$1"
DEST="$2"

# コピー元が存在するか
if [ ! -d "$SRC" ]; then
    echo "エラー: コピー元 '$SRC' が存在しないか、ディレクトリではありません。" >&2
    exit 1
fi

# コピー元がGitリポジトリか
if [ ! -d "$SRC/.git" ]; then
    echo "エラー: コピー元 '$SRC' に .git フォルダが見つかりません。" >&2
    exit 1
fi

# コピー先が既に存在するか確認
if [ -e "$DEST" ]; then
    echo "エラー: コピー先 '$DEST' は既に存在します。" >&2
    exit 1
fi

# コピー先ディレクトリを作成
mkdir -p "$DEST"

# 1. .gitignore を尊重してファイルをコピー（サブモジュール内の .gitignore も再帰的に適用）
rsync -a --exclude='.git' --filter=':- .gitignore' "$SRC/" "$DEST/"

# 2. .git フォルダをそのまま複製（サブモジュールの履歴情報も含まれます）
cp -r "$SRC/.git" "$DEST/.git"

# サブモジュールの存在チェック
if [ -d "$SRC/.git/modules" ]; then
    echo "サブモジュールを検出・コピーしました。"
fi

echo "完了: '$SRC' を '$DEST' にコピーしました（サブモジュール対応、Git無視ファイル除外済み）。"
