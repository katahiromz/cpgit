#!/bin/bash

set -e

VERSION="1.1"

# Help message
show_help() {
    cat << EOF
Usage: cpgit [OPTIONS] <source_directory> <destination_directory>

Copy a Git repository excluding ignored files while preserving .git history and submodules.

Options:
  -h, --help     Show this help message and exit
  -v, --version  Show version information and exit

Examples:
  cpgit my-repo my-repo-copy
EOF
}

# Parse options
case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
    -v|--version)
        echo "cpgit version $VERSION"
        exit 0
        ;;
esac

# Check arguments
if [ "$#" -ne 2 ]; then
    echo "Error: Invalid number of arguments." >&2
    show_help >&2
    exit 1
fi

SRC="$1"
DEST="$2"

# Check if source directory exists
if [ ! -d "$SRC" ]; then
    echo "Error: Source '$SRC' does not exist or is not a directory." >&2
    exit 1
fi

# Check if source directory is a Git repository
if [ ! -d "$SRC/.git" ]; then
    echo "Error: Source '$SRC' does not contain a .git directory." >&2
    exit 1
fi

# Check if destination directory already exists
if [ -e "$DEST" ]; then
    echo "Error: Destination '$DEST' already exists." >&2
    exit 1
fi

# Convert destination to absolute path before cd
DEST_ABS="$(mkdir -p "$DEST" && cd "$DEST" && pwd)"

# 1. Copy all tracked files (including submodules) respecting .gitignore
(
    cd "$SRC"
    git checkout-index -a -f --prefix="$DEST_ABS/"
    git submodule --quiet foreach --recursive \
        'git checkout-index -a -f --prefix="$DEST_ABS/$displaypath/"'
)

# 2. Copy the .git directory
cp -r "$SRC/.git" "$DEST/.git"

# Check if submodules were copied
if [ -d "$SRC/.git/modules" ]; then
    echo "Submodules detected and copied."
fi

echo "Success: Copied '$SRC' to '$DEST' (including submodules, ignored files excluded)."
