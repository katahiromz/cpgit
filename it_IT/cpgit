#!/bin/bash

set -e

VERSION="1.1"

# Messaggio di aiuto
show_help() {
    cat << EOF
Uso: cpgit [OPZIONI] <cartella_origine> <cartella_destinazione>

Copia un repository Git escludendo i file ignorati, mantenendo la cronologia .git e i sottomoduli.

Opzioni:
  -h, --help     Mostra questo messaggio di aiuto ed esce
  -v, --version  Mostra le informazioni sulla versione ed esce

Esempio:
  cpgit mio-repo mio-repo-copia
EOF
}

# Analisi delle opzioni
case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
    -v|--version)
        echo "cpgit versione $VERSION"
        exit 0
        ;;
esac

# Controllo degli argomenti
if [ "$#" -ne 2 ]; then
    echo "Errore: Numero di argomenti non valido." >&2
    show_help >&2
    exit 1
fi

SRC="$1"
DEST="$2"

# Verifica se la cartella di origine esiste
if [ ! -d "$SRC" ]; then
    echo "Errore: L'origine '$SRC' non esiste o non è una cartella." >&2
    exit 1
fi

# Verifica se l'origine è un repository Git
if [ ! -d "$SRC/.git" ]; then
    echo "Errore: L'origine '$SRC' non contiene una cartella .git." >&2
    exit 1
fi

# Verifica se la cartella di destinazione esiste già
if [ -e "$DEST" ]; then
    echo "Errore: La destinazione '$DEST' esiste già." >&2
    exit 1
fi

# Converti la destinazione in un percorso assoluto
DEST_ABS="$(mkdir -p "$DEST" && cd "$DEST" && pwd)"

# 1. Copiare solo i file tracciati (inclusi i sottomoduli)
(
    cd "$SRC"
    git checkout-index -a -f --prefix="$DEST_ABS/"
    git submodule --quiet foreach --recursive \
        'git checkout-index -a -f --prefix="$DEST_ABS/$displaypath/"'
)

# 2. Copiare la cartella .git
cp -r "$SRC/.git" "$DEST/.git"

# Controllo sottomoduli
if [ -d "$SRC/.git/modules" ]; then
    echo "Sottomoduli rilevati e copiati."
fi

echo "Successo: '$SRC' è stato copiato in '$DEST' (sottomoduli inclusi, file ignorati esclusi)."
