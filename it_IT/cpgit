#!/bin/bash

set -e

# Controllo degli argomenti
if [ "$#" -ne 2 ]; then
    echo "Uso: $0 <cartella_origine> <cartella_destinazione>" >&2
    exit 1
fi

SRC="$1"
DEST="$2"

# Verifica se la cartella di origine esiste
if [ ! -d "$SRC" ]; then
    echo "Errore: L'origine '$SRC' non esiste o non è una cartella." >&2
    exit 1
fi

# Verifica se l'origine è un repository Git
if [ ! -d "$SRC/.git" ]; then
    echo "Errore: L'origine '$SRC' non contiene una cartella .git." >&2
    exit 1
fi

# Verifica se la cartella di destinazione esiste già
if [ -e "$DEST" ]; then
    echo "Errore: La destinazione '$DEST' esiste già." >&2
    exit 1
fi

# Creazione della cartella di destinazione
mkdir -p "$DEST"

# 1. Copiare i file rispettando il file .gitignore (inclusi i sottomoduli)
rsync -a --exclude='.git' --filter=':- .gitignore' "$SRC/" "$DEST/"

# 2. Copiare la cartella .git (contiene le informazioni sui sottomoduli)
cp -r "$SRC/.git" "$DEST/.git"

# Controllo sottomoduli
if [ -d "$SRC/.git/modules" ]; then
    echo "Sottomoduli rilevati e copiati."
fi

echo "Successo: '$SRC' è stato copiato in '$DEST' (sottomoduli inclusi, file ignorati esclusi)."
