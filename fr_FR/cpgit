#!/bin/bash

set -e

VERSION="1.1"

# Message d'aide
show_help() {
    cat << EOF
Usage : cpgit [OPTIONS] <répertoire_source> <répertoire_destination>

Copie un dépôt Git en excluant les fichiers ignorés tout en conservant l'historique .git et les sous-modules.

Options :
  -h, --help     Afficher ce message d'aide et quitter
  -v, --version  Afficher les informations de version et quitter

Exemple :
  cpgit mon-depot mon-depot-copie
EOF
}

# Analyse des options
case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
    -v|--version)
        echo "cpgit version $VERSION"
        exit 0
        ;;
esac

# Vérification des arguments
if [ "$#" -ne 2 ]; then
    echo "Erreur : Nombre d'arguments invalide." >&2
    show_help >&2
    exit 1
fi

SRC="$1"
DEST="$2"

# Vérification de l'existence du répertoire source
if [ ! -d "$SRC" ]; then
    echo "Erreur : La source '$SRC' n'existe pas ou n'est pas un répertoire." >&2
    exit 1
fi

# Vérification si le répertoire source est un dépôt Git
if [ ! -d "$SRC/.git" ]; then
    echo "Erreur : La source '$SRC' ne contient pas de dossier .git." >&2
    exit 1
fi

# Vérification si le répertoire de destination existe déjà
if [ -e "$DEST" ]; then
    echo "Erreur : La destination '$DEST' existe déjà." >&2
    exit 1
fi

# Convertir la destination en chemin absolu
DEST_ABS="$(mkdir -p "$DEST" && cd "$DEST" && pwd)"

# 1. Copier uniquement les fichiers suivis (y compris les sous-modules)
(
    cd "$SRC"
    git checkout-index -a -f --prefix="$DEST_ABS/"
    git submodule --quiet foreach --recursive \
        'git checkout-index -a -f --prefix="$DEST_ABS/$displaypath/"'
)

# 2. Copier le dossier .git
cp -r "$SRC/.git" "$DEST/.git"

# Vérification des sous-modules
if [ -d "$SRC/.git/modules" ]; then
    echo "Sous-modules détectés et copiés."
fi

echo "Succès : '$SRC' a été copié vers '$DEST' (sous-modules inclus, fichiers ignorés exclus)."
